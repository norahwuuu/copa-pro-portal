{
  "private": true,
  "version": "0.0.6",
  "scripts": {
    "start": "cross-env PORT=3000 umi dev",
    "build:development": "cross-env UMI_ENV=dev umi build",
    "start:qa": "cross-env PORT=3000 UMI_ENV=qa umi dev",
    "build:qa": "cross-env UMI_ENV=qa umi build",
    "start:prod": "cross-env PORT=3000 UMI_ENV=prod umi dev",
    "build:prod": "cross-env UMI_ENV=prod umi build",
    "start:analyze": "cross-env UMI_ENV=cloud ANALYZE=1 umi dev",
    "build:analyze": "cross-env UMI_ENV=cloud umi build",
    "postinstall": "umi generate tmp",
    "prettier": "prettier --write '**/*.{js,jsx,tsx,ts,less,md,json}'",
    "test": "umi-test",
    "test:coverage": "umi-test --coverage",
    "commit": "git-cz",
    "lint:style": "stylelint --fix \"src/**/*.less\" --syntax less",
    "lint:fix": "eslint --fix --cache --ext .js,.jsx,.ts,.tsx --format=pretty ./src && npm run lint:style",
    "lint-staged:js": "eslint --ext .js,.jsx,.ts,.tsx ",
    "lint-staged": "lint-staged",
    "tsc": "tsc --noEmit"
  },
  "lint-staged": {
    "**/*.less": "stylelint --syntax less",
    "**/*.{js,jsx,tsx,ts,less,md,json}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@emotion/react": "^11.10.4",
    "@emotion/styled": "^11.10.4",
    "@mdi/js": "^7.0.96",
    "@mui/icons-material": "^5.10.9",
    "@mui/material": "^5.10.9",
    "@okta/okta-auth-js": "^7.1.1",
    "@umijs/fabric": "^3.0.0",
    "@umijs/plugin-crossorigin": "^1.2.1",
    "@umijs/plugin-dva": "^0.13.2",
    "@umijs/plugin-initial-state": "^2.4.0",
    "@umijs/plugin-locale": "^0.16.0",
    "@umijs/plugin-model": "^2.6.2",
    "ahooks": "^3.7.2",
    "commitizen": "^4.2.5",
    "cross-env": "^7.0.3",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.39",
    "react": "17.x",
    "react-dom": "17.x",
    "redux-mock-store": "^1.5.4",
    "umi": "^3.5.34",
    "umi-request": "^1.4.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^8.19.0",
    "@testing-library/jest-dom": "^4.2.4",
    "@testing-library/react": "^12.1.2",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.2.2",
    "@types/react": "^17.0.52",
    "@types/react-dom": "^16.9.17",
    "@types/redux-mock-store": "^1.0.3",
    "@typescript-eslint/eslint-plugin": "^5.40.1",
    "@typescript-eslint/parser": "^5.40.1",
    "@umijs/test": "^3.5.34",
    "eslint": "^8.26.0",
    "eslint-plugin-react": "^7.31.10",
    "file-loader": "^6.2.0",
    "lint-staged": "^10.5.4",
    "prettier": "^2.7.1",
    "typescript": "^4.1.2",
    "yorkie": "^2.0.0"
  }
}
